# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Plugins are Lua source: show them as text in a browser instead of
# downloading a file with no type.
/plugins/*
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

# The Market list, readable from OXIS in a browser tab.
/index.json
  Access-Control-Allow-Origin: *

/assets/*
  Cache-Control: public, max-age=604800

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8
